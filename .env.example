NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Confu's own Groq keys, used by Pro and owner accounts (Free users bring their own).
# Server-only. Comma or newline separated; requests rotate across them and skip a
# key that Groq has rate-limited. GROQ_API_KEY (one key) is included too.
GROQ_API_KEYS=
GROQ_API_KEY=
# Tokens each Pro account may use per rolling 24 hours (default 200000). Owners are unlimited.
PRO_DAILY_TOKENS=200000
# Optional model overrides
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Encrypts users' Groq keys at rest. 32+ random characters, e.g. `openssl rand -base64 48`.
# Keep it stable: changing it makes stored keys unreadable (users re-enter them).
KEY_ENCRYPTION_SECRET=
# Optional: scholarly search for paper sessions. Free keys at semanticscholar.org/product/api;
# without one, Semantic Scholar's shared pool is often rate-limited and Confu falls back to arXiv + OpenAlex.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: your email, sent to OpenAlex/arXiv as a polite contact.
OPENALEX_MAILTO=
