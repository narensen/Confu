NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Confu's own Groq keys, used by Pro and owner accounts (Free users bring their own).
# Server-only. Comma or newline separated; requests rotate across them and skip a
# key that Groq has rate-limited. GROQ_API_KEY (one key) is included too.
GROQ_API_KEYS=
GROQ_API_KEY=
# Tokens each Pro account may use per rolling 24 hours (default 200000). Owners are unlimited.
PRO_DAILY_TOKENS=200000
# Optional model overrides
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Encrypts users' Groq keys at rest. 32+ random characters, e.g. `openssl rand -base64 48`.
# Keep it stable: changing it makes stored keys unreadable (users re-enter them).
KEY_ENCRYPTION_SECRET=
# Optional: scholarly search for paper sessions. Free keys at semanticscholar.org/product/api;
# without one, Semantic Scholar's shared pool is often rate-limited and Confu falls back to arXiv + OpenAlex.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: your email, sent to OpenAlex/arXiv as a polite contact.
OPENALEX_MAILTO=
# Recommended for paper search and recommendations: a free key from openalex.org/settings/api.
# Without it, every app on the server's IP shares one small daily budget, which runs out fast on Vercel.
OPENALEX_API_KEY=

# Google Drive import (optional; the Drive tab stays hidden until all three are set).
# Public by design: the browser uses them. Restrict the API key to your domains.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID = the OAuth web client ID (same as Google sign-in)
# NEXT_PUBLIC_GOOGLE_API_KEY   = an API key restricted to the Google Picker API
# NEXT_PUBLIC_GOOGLE_APP_ID    = your Google Cloud project number
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Reminders and weekly summaries (optional; each switches on when set).
# SUPABASE_SERVICE_ROLE_KEY: server-only (Supabase → Settings → API keys → secret). Used only by the daily job.
SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET: any long random string; Vercel Cron sends it to /api/cron/daily.
CRON_SECRET=
# Email via Resend (resend.com), from a domain you've verified there.
RESEND_API_KEY=
EMAIL_FROM="Confu <hello@mail.confu.lol>"
# Browser notifications: generate with `bunx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: the site's address in emails and calendar links (default https://confu.lol).
NEXT_PUBLIC_SITE_URL=
# Optional: at most this many emails a day (Resend's free plan allows 100).
EMAIL_DAILY_LIMIT=

# Pro subscriptions through Lemon Squeezy (optional; checkout opens once the first four are set).
# LEMONSQUEEZY_API_KEY:        Settings → API in Lemon Squeezy (server-only)
# LEMONSQUEEZY_STORE_ID:       your store's number (Settings → Stores)
# LEMONSQUEEZY_VARIANT_INTL:   the Pro variant at $6/month
# LEMONSQUEEZY_VARIANT_INDIA:  optional: the India variant, priced at the dollar equivalent of ₹299/month
# LEMONSQUEEZY_WEBHOOK_SECRET: the signing secret of a webhook to https://<your site>/api/billing/webhook
#                              sending the subscription_* events
# STUDENT_DISCOUNT_CODE:       optional: a Lemon Squeezy discount code applied automatically for college emails
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_INTL=
LEMONSQUEEZY_VARIANT_INDIA=
LEMONSQUEEZY_WEBHOOK_SECRET=
STUDENT_DISCOUNT_CODE=
