{
  "name": "confu",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@confu/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "turbo": "^2",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.3",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "electron",
    "sharp",
    "unrs-resolver"
  ]
}
