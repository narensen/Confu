  "main": "dist/main/main.cjs",
  "type": "module",
  "devDependencies": {
    "@confu/ai": "workspace:*",
    "@confu/app": "workspace:*",
    "@confu/client": "workspace:*",
    "@confu/storage": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "katex": "0.16.47",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-main.mjs",
