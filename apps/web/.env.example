# ── Required ──────────────────────────────────────────────────────────────
# These three are all Confu needs to run. Everything below them is optional:
# leave a line empty and that feature stays off.

# Supabase → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Everyone brings their own AI (Settings → Your AI): an API key from any provider,
# or their OpenRouter account. This encrypts those keys at rest. Required.
# 32+ random characters, e.g. `openssl rand -base64 48`.
# Keep it stable: changing it makes stored keys unreadable (users re-enter them).
KEY_ENCRYPTION_SECRET=
# ── Optional ──────────────────────────────────────────────────────────────

# The server's own Groq keys. The owner uses a personal key first;
# these keys answer when that provider can't. Everyone else gets 10 free
# prompts and 20 scanned pages, once. Leave empty to turn
# both off. Server-only. Comma or newline separated; requests rotate across
# them and skip a key that Groq has rate-limited.
GROQ_API_KEYS=
GROQ_API_KEY=
# Optional model overrides for the server's keys (also the defaults for students' Groq keys)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Let students point "Other (OpenAI-compatible)" at addresses on this server's own
# network (e.g. Ollama on localhost). Only for a Confu that only you use: on a shared
# server it would let anyone make it fetch internal addresses.
# ALLOW_PRIVATE_AI_URLS=1
# Optional: scholarly search for paper sessions. Free keys at semanticscholar.org/product/api;
# without one, Semantic Scholar's shared pool is often rate-limited and Confu falls back to arXiv + OpenAlex.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: your email, sent to OpenAlex/arXiv as a polite contact.
OPENALEX_MAILTO=
# Recommended for paper search and recommendations: a free key from openalex.org/settings/api.
# Without it, every app on the server's IP shares one small daily budget, which runs out fast on Vercel.
OPENALEX_API_KEY=

# Google Drive (optional): importing files, syncing the on-device app (/app) to the
# student's own Drive, and shared-session links. Only the drive.file scope is used
# (Confu sees only files it created), which needs no paid security review.
# Public by design: the browser uses them. Restrict the API key to your domains.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID = the OAuth web client ID; add your site (and
#                                http://localhost:3000) as authorized JavaScript origins
# NEXT_PUBLIC_GOOGLE_API_KEY   = an API key allowed to use the Google Picker API and the
#                                Google Drive API (opening shared-session links)
# NEXT_PUBLIC_GOOGLE_APP_ID    = your Google Cloud project number (the Picker)
# Sync needs only the client ID; shared links need the API key too.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Reminders and weekly summaries (optional; each switches on when set).
# SUPABASE_SERVICE_ROLE_KEY: server-only (Supabase → Settings → API keys → secret). Used only by the daily job.
SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET: any long random string; Vercel Cron sends it to /api/cron/daily.
CRON_SECRET=
# Email via Resend (resend.com), from a domain you've verified there.
RESEND_API_KEY=
EMAIL_FROM="Confu <hello@mail.confu.lol>"
# Browser notifications: generate with `bunx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: the site's address in emails and calendar links (default https://confu.lol).
NEXT_PUBLIC_SITE_URL=
# Optional: at most this many emails a day (Resend's free plan allows 100).
EMAIL_DAILY_LIMIT=

# Voice rooms: a TURN relay so calls connect across strict networks (mobile data,
# campus Wi-Fi). Without one, voice still works on most home networks. Pick one:
#   Cloudflare TURN (free tier): CLOUDFLARE_TURN_KEY_ID + CLOUDFLARE_TURN_API_TOKEN
#   coturn with a shared secret: TURN_URLS + TURN_SECRET
#   static credentials:          TURN_URLS + TURN_USERNAME + TURN_CREDENTIAL
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SECRET=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Sign-up captcha: Cloudflare Turnstile's site key, when CAPTCHA protection is on
# in Supabase (Authentication → Attack Protection). Public by design.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Moderation of public threads and replies, with TypeSafe's Jev model
# (docs.typesafe.ai). Posts it flags get a second look from a model on the
# server's Groq keys above. Off without a key.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# JEV_FIX_THRESHOLD=0.5   # above this, a model double-checks the post
# JEV_HIDE_THRESHOLD=0.9  # above this, it's hidden for the owner to review
